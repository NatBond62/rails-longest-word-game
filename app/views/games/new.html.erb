<h1>New game</h1>
<div class="d-flex align-items-center mx-auto">
  <% @letters.each do |letter| %>
    <p class="bg-primary text-white px-2 mx-2 border border-dark"><%= letter.capitalize %></p>
  <% end %>
</div>
<div class="d-flex align-items-center mx-auto">
  <form action="score" method="post" data-turbo="false">
      <label for="word">Whats is the longest word you can find ?</label>
      <div class = "d-flex">
        <input type="text" id="word" name="word" required>
        <button type="submit">Play</button>
      </div>
    <%= hidden_field_tag :letters, @letters.join %>
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
  </form>
</div>
